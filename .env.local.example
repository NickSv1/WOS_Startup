# Twilio — the outbound SMS nudge
TWILIO_SID=ACxxxxxxxx
TWILIO_TOKEN=xxxxxxxx
TWILIO_FROM=+61xxxxxxxxx
DEMO_PHONE=+61xxxxxxxxx          # must be VERIFIED in a Twilio trial account

# Claude — the coach's phrasing only (never the math)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
